# Gateway runtime
GATEWAY_SERVER_PORT=8443
GATEWAY_PUBLIC_PORT=8443
GATEWAY_TLS_CERT=./certs/cert.pem
GATEWAY_TLS_KEY=./certs/key.pem
GATEWAY_UPSTREAM_URL=https://api.anthropic.com

# Use a proxy endpoint that is reachable from both local npm and Docker runtime.
# On Windows + Docker Desktop, a host LAN IP is usually safer than 127.0.0.1.
GATEWAY_PROXY_URL=http://your-host-lan-ip:10808

# Gateway-managed OAuth
GATEWAY_OAUTH_ACCESS_TOKEN=
GATEWAY_OAUTH_REFRESH_TOKEN=replace-me
GATEWAY_OAUTH_EXPIRES_AT=

# Client access token distribution
GATEWAY_CLIENT_PRIMARY_NAME=local-dev
GATEWAY_CLIENT_PRIMARY_TOKEN=replace-me

# Canonical identity
GATEWAY_IDENTITY_DEVICE_ID=replace-with-64-char-hex
GATEWAY_IDENTITY_EMAIL=user@example.com

# Logging
GATEWAY_LOG_LEVEL=info
GATEWAY_LOG_AUDIT=true
GATEWAY_LOG_FILE=./runtime/logs/gateway.log
GATEWAY_AUDIT_LOG_FILE=./runtime/logs/audit.log

# Reserved future control-plane services
ADMIN_API_PORT=3100
ADMIN_WEB_PORT=3000
DATABASE_URL=
